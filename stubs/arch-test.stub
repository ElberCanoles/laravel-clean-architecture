<?php

declare(strict_types=1);

use PHPUnit\Framework\AssertionFailedError;

test('{{Context}} classes are visible to the architecture tests', function () {
    // Every rule below passes when Pest sees no classes in the context, which
    // is what happens when Laravel has not autoloaded it before the first
    // architecture test of the run. So this rule has to fail: a context is
    // never made of interfaces alone.
    $visible = false;

    try {
        expect('{{Namespace}}')->toBeInterfaces();
    } catch (AssertionFailedError) {
        $visible = true;
    }

    expect($visible)->toBeTrue('Pest sees no classes in {{Namespace}}, so every rule in this file passes without checking anything. See "Architecture Tests" in the laravel-clean-architecture README.');
});

test('{{Context}} domain does not depend on infrastructure', function () {
    expect('{{Namespace}}\Domain')
        ->toOnlyUse('CleanArchitecture\Support');
});

test('{{Context}} domain does not depend on application layer', function () {
    expect('{{Namespace}}\Domain')
        ->not->toUse('{{Namespace}}\Application');
});

test('{{Context}} application does not depend on presentation', function () {
    expect('{{Namespace}}\Application')
        ->not->toUse('{{Namespace}}\Presentation');
});

test('{{Context}} application does not depend on infrastructure', function () {
    expect('{{Namespace}}\Application')
        ->not->toUse('{{Namespace}}\Infrastructure');
});

test('{{Context}} application does not depend on the framework', function () {
    expect('{{Namespace}}\Application')
        ->not->toUse('Illuminate');
});

test('{{Context}} presentation does not depend on infrastructure', function () {
    expect('{{Namespace}}\Presentation')
        ->not->toUse('{{Namespace}}\Infrastructure');
});

test('{{Context}} eloquent models never leave infrastructure', function () {
    expect('{{Namespace}}\Infrastructure\Models')
        ->toOnlyBeUsedIn('{{Namespace}}\Infrastructure');
});

test('{{Context}} code declares strict types', function () {
    expect('{{Namespace}}')
        ->toUseStrictTypes();
});

test('{{Context}} entities are final classes', function () {
    expect('{{Namespace}}\Domain\Entities')
        ->toBeFinal();
});

test('{{Context}} repositories in domain are interfaces', function () {
    expect('{{Namespace}}\Domain\Repositories')
        ->toBeInterfaces();
});

test('{{Context}} value objects are readonly', function () {
    expect('{{Namespace}}\Domain\ValueObjects')
        ->toBeReadonly();
});
