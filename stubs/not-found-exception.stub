<?php

declare(strict_types=1);

namespace {{Namespace}}\Domain\Exceptions;

use CleanArchitecture\Support\ProvidesHttpStatus;

final class {{Class}}NotFound extends \DomainException implements ProvidesHttpStatus
{
    public static function withId(string $id): self
    {
        return new self("{{Class}} with id [{$id}] was not found.");
    }

    public function httpStatus(): int
    {
        return 404;
    }
}
