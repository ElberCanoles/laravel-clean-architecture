<?php

declare(strict_types=1);

namespace {{Namespace}}\Domain\Entities;

use CleanArchitecture\Support\HasDomainEvents;
use {{Namespace}}\Domain\Events\{{Class}}CreatedEvent;

final class {{Class}} implements HasDomainEvents
{
    /** @var object[] */
    private array $domainEvents = [];

    private function __construct(
        private readonly string $id,
    ) {
    }

    public static function create(string $id): self
    {
        $entity = new self($id);
        $entity->recordEvent(new {{Class}}CreatedEvent($id));

        return $entity;
    }

    /** @internal Used only for persistence reconstitution */
    public static function fromPersistence(string $id): self
    {
        return new self($id);
    }

    public function id(): string
    {
        return $this->id;
    }

    /**
     * Entities are equal when they share the same identity, regardless of state.
     */
    public function equals(self $other): bool
    {
        return $this->id === $other->id;
    }

    private function recordEvent(object $event): void
    {
        $this->domainEvents[] = $event;
    }

    /** @return object[] */
    public function releaseEvents(): array
    {
        $events = $this->domainEvents;
        $this->domainEvents = [];

        return $events;
    }
}
