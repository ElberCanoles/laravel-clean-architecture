{
  "name": "elber/laravel-clean-architecture",
  "description": "DDD + Clean Architecture scaffolding for Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Elber Canoles",
      "role": "Developer"
    }
  ],
  "keywords": [
    "laravel",
    "ddd",
    "clean-architecture",
    "cqrs",
    "bounded-context"
  ],
  "homepage": "https://github.com/ElberCanoles/laravel-clean-architecture",
  "support": {
    "issues": "https://github.com/ElberCanoles/laravel-clean-architecture/issues",
    "source": "https://github.com/ElberCanoles/laravel-clean-architecture",
    "security": "https://github.com/ElberCanoles/laravel-clean-architecture/security/advisories"
  },
  "autoload": {
    "psr-4": {
      "CleanArchitecture\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CleanArchitecture\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CleanArchitecture\\CleanArchitectureServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.17|^12.0|^13.0",
    "illuminate/support": "^11.17|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.8|^4.1|^5.0",
    "pestphp/pest-plugin-arch": "^3.1|^4.0|^5.0",
    "phpstan/phpstan": "^2.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse",
    "lint": "pint --test",
    "fix": "pint",
    "test:mutate": "pest --mutate --parallel"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
